# ---------------------------------------------------------------
# Copy this file to .env and fill in. NEVER commit .env to git.
# ---------------------------------------------------------------

DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# ---------------------------------------------------------------
# CyberSource
# 'test' uses apitest.cybersource.com, 'production' uses api.cybersource.com.
# Test and production credentials are NOT interchangeable.
# ---------------------------------------------------------------
CYBS_ENVIRONMENT=test

# --- Zanaco merchant account ---
CYBS_ZANACO_MERCHANT_ID=
CYBS_ZANACO_KEY_ID=
CYBS_ZANACO_SHARED_SECRET=

# --- Absa merchant account ---
CYBS_ABSA_MERCHANT_ID=
CYBS_ABSA_KEY_ID=
CYBS_ABSA_SHARED_SECRET=

# --- Which account settles which currency ---
# Confirm this with each bank before going live. Sending a currency to an
# acquirer that cannot settle it causes declines or settlement rejections.
CYBS_ACCOUNT_FOR_ZMW=zanaco
CYBS_ACCOUNT_FOR_USD=absa
